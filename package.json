{
  "name": "jdh-cli",
  "version": "1.0.0",
  "description": "CLI that converts Jupyter articles from the Journal of Digital History into a MyST project and builds a PDF with Typst.",
  "homepage": "https://github.com/C2DH/jdh-cli#readme",
  "bugs": {
    "url": "https://github.com/C2DH/jdh-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C2DH/jdh-cli.git"
  },
  "keywords": [
    "jupyter",
    "markdown",
    "myst",
    "pdf",
    "typst",
    "conversion"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "jdh-cli": "dist/jdh-cli.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run clean && bun run copy:version && bun run copy:templates && bun run build:cli",
    "build:cli": "bun build src/index.ts --outfile=dist/jdh-cli.cjs --target=node --format=cjs --minify",
    "build:standalone": "bun run copy:version && bun build --compile src/index.ts --outfile dist/jdh-cli",
    "build:watch": "bun run dev:build",
    "clean": "rm -rf dist",
    "compile": "tsc --noEmit",
    "copy:templates": "bun scripts/copy-templates.ts",
    "copy:version": "bun scripts/copy-version.ts",
    "dev": "bun run link && bun run dev:build",
    "dev:build": "bun run copy:version && bun run copy:templates && bun build src/index.ts --outfile=dist/jdh-cli.cjs --target=node --format=cjs --sourcemap=inline --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "link": "bun run unlink && bun link",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "bun src/index.ts",
    "test": "bun test",
    "unlink": "bun unlink jdh-cli 2>/dev/null || true"
  },
  "dependencies": {
    "@retorquere/bibtex-parser": "^11.0.0",
    "commander": "^14.0.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.60.1"
  },
  "engines": {
    "node": ">=20 <=26"
  }
}
